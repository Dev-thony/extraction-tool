# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Neon and Supabase free tiers both work.
DATABASE_URL="postgresql://user:password@localhost:5432/extraction?schema=public"

# ── Provider selection (mock-first defaults; no cloud keys required) ─────────
OCR_PROVIDER="mock"          # mock | gemini
STORAGE_PROVIDER="local"     # local | supabase
AUTH_PROVIDER="dev"          # dev | supabase

# ── Google Gemini Vision (only when OCR_PROVIDER=gemini) ─────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ── Supabase (only when STORAGE_PROVIDER or AUTH_PROVIDER = supabase) ─────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# ── Local storage (LocalStorageProvider) ─────────────────────────────────────
LOCAL_STORAGE_DIR="storage/uploads"

# ── Dev auth (DevAuthProvider) — replace secret before any real deployment ───
AUTH_SESSION_SECRET="dev-only-secret-change-me-to-32+-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"

# ── Tuning ───────────────────────────────────────────────────────────────────
LOW_CONFIDENCE_THRESHOLD="0.7"   # fields below this (0..1) are flagged on review
