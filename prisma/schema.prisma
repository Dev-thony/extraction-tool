// Prisma schema for the Handwritten Data Extraction Platform.
//
// Enum values are kept identical to packages/types/src/enums.ts — update both
// together. Provider is PostgreSQL from day one; set DATABASE_URL to a Neon or
// Supabase connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  PROCESSED
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Record {
  id          String  @id @default(cuid())
  imageUrl    String
  imageKey    String
  fullName    String?
  userName    String? // surfaced as "Partnership Name" in the admin UI
  phoneNumber String?
  email       String?
  pukNumber   String?

  confidence       Float?
  fieldConfidences Json? // per-field 0..1 confidences for review highlighting
  rawOCR           String?
  status           ProcessingStatus @default(PENDING)

  // Free-form uploader label while the extractor is open; becomes a User FK
  // once accounts are introduced (SaaS phase).
  uploadedBy String?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      ProcessingLog[]

  @@index([status])
  @@index([createdAt])
  @@map("records")
}

model ProcessingLog {
  id        String   @id @default(cuid())
  recordId  String?
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: SetNull)
  event     String
  level     LogLevel @default(INFO)
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([recordId])
  @@index([level])
  @@map("processing_logs")
}
